{
  "version": "0.7.1",
  "note": "命中只是候选，不是判决。w 为权重：3=中文里几乎总是腔调，2=多数情况是腔调，1=看用途。keep 写的是应当保留的情形。",
  "categories": {
    "opener": "开场铺垫",
    "closer": "收尾套话",
    "chat": "聊天腔",
    "jargon": "黑话",
    "hype": "宣传夸饰",
    "lofty": "空泛拔高",
    "template": "句式模板",
    "transl": "翻译腔",
    "literary": "文艺腔",
    "webslang": "网感硬凹",
    "engineer": "工程师腔",
    "service": "服务腔",
    "trace": "工具痕迹"
  },
  "rules": [
    {
      "id": "op-zhide",
      "cat": "opener",
      "w": 3,
      "re": "值得(注意|一提|关注|强调|肯定)的是",
      "hint": "删掉提示语，直接说后面的内容",
      "keep": "后面确实是风险或例外时，可改成“要注意”"
    },
    {
      "id": "op-xuyao",
      "cat": "opener",
      "w": 2,
      "re": "需要(指出|强调|说明|注意)的是",
      "hint": "删掉，直接说"
    },
    {
      "id": "op-bukefouren",
      "cat": "opener",
      "w": 2,
      "re": "不可否认(的是)?",
      "hint": "删掉，直接说"
    },
    {
      "id": "op-wuyong",
      "cat": "opener",
      "w": 3,
      "re": "毋庸置疑|不言而喻|显而易见",
      "hint": "删掉；真需要强调就给理由"
    },
    {
      "id": "op-zhongsuo",
      "cat": "opener",
      "w": 3,
      "re": "众所周知",
      "hint": "删掉，或给出处"
    },
    {
      "id": "op-bunan",
      "cat": "opener",
      "w": 2,
      "re": "不难(发现|看出)",
      "hint": "删掉，直接说发现了什么"
    },
    {
      "id": "op-dangjin",
      "cat": "opener",
      "w": 3,
      "re": "在当今(这个)?[^，。！？；“”\\n]{0,12}(时代|社会|世界|环境下|背景下)",
      "hint": "删掉，或换成具体时间"
    },
    {
      "id": "op-suizhe",
      "cat": "opener",
      "w": 2,
      "re": "随着[^，。！？；“”\\n]{1,20}的(不断|快速|飞速|迅猛|日益|广泛)?(发展|普及|进步|深入|推进|兴起)",
      "hint": "删掉，或说清楚具体变了什么"
    },
    {
      "id": "op-zhegeshidai",
      "cat": "opener",
      "w": 3,
      "re": "在这个[^，。！？；“”\\n]{1,12}的时代",
      "hint": "删掉"
    },
    {
      "id": "op-beijing",
      "cat": "opener",
      "w": 2,
      "re": "在[^，。！？；“”\\n]{1,14}的(大)?背景下|在这样的背景下",
      "hint": "删掉；背景真有用就直接写那件事"
    },
    {
      "id": "op-jiyuci",
      "cat": "opener",
      "w": 1,
      "re": "基于此[，,]",
      "hint": "多数可删",
      "keep": "学术摘要里承接研究空白时可保留"
    },
    {
      "id": "op-rangwomen",
      "cat": "opener",
      "w": 3,
      "re": "让我们(一起)?(来)?(看看|探讨|深入|聊聊|走进|揭开|了解)",
      "hint": "删掉，直接开始讲"
    },
    {
      "id": "op-benwen",
      "cat": "opener",
      "w": 2,
      "re": "本文将(会)?(深入)?(探讨|介绍|分析|剖析|解读|阐述)",
      "hint": "换成“这篇讲……”或直接进入正题",
      "keep": "长文导读需要交代结构时"
    },
    {
      "id": "op-xiamian",
      "cat": "opener",
      "w": 3,
      "re": "下面(我|我们)(将|来|会)(从|为你|为您|详细|逐一)",
      "hint": "删掉预告，直接给内容"
    },
    {
      "id": "op-cong-fangmian",
      "cat": "opener",
      "w": 3,
      "re": "(我|我们)将从[^，。！？；“”\\n]{1,8}(方面|角度|维度)",
      "hint": "删掉预告"
    },
    {
      "id": "cl-zongeryanzhi",
      "cat": "closer",
      "w": 3,
      "re": "总而言之|综上所述|一言以蔽之",
      "hint": "删掉；前文已经说清就不必再总结",
      "keep": "学术论文的结论段"
    },
    {
      "id": "cl-zongdeshuo",
      "cat": "closer",
      "w": 2,
      "re": "总的来说|总体来看|总体而言|总结(一下|来说)",
      "hint": "删掉，直接给结论"
    },
    {
      "id": "cl-zongzhi",
      "cat": "closer",
      "w": 1,
      "re": "总之[，,]",
      "hint": "多数可删"
    },
    {
      "id": "cl-youcikejian",
      "cat": "closer",
      "w": 2,
      "re": "由此可见|由此可以看出|归根结底|说到底",
      "hint": "删掉，结论自己能立住"
    },
    {
      "id": "cl-xiwang",
      "cat": "closer",
      "w": 3,
      "re": "希望[^。！？；“”\\n]{0,14}(对你|对您|能|可以)[^。！？；“”\\n]{0,8}(有所)?(帮助|启发|参考|收获)",
      "hint": "删掉"
    },
    {
      "id": "cl-qitawenti",
      "cat": "closer",
      "w": 3,
      "re": "如果你(还)?有(任何)?(其他|更多)?的?(问题|疑问|需要)",
      "hint": "删掉"
    },
    {
      "id": "cl-suishi",
      "cat": "closer",
      "w": 3,
      "re": "欢迎随时(提问|问我|联系|交流|留言|找我)",
      "hint": "删掉，或写清找谁、怎么找"
    },
    {
      "id": "cl-qidai",
      "cat": "closer",
      "w": 1,
      "re": "期待(您|你)的(回复|反馈|回音)",
      "hint": "可保留一句，别加感叹号",
      "keep": "商务邮件里一句平实的“期待您的回复”"
    },
    {
      "id": "cl-shimuyidai",
      "cat": "closer",
      "w": 3,
      "re": "让我们拭目以待|未来可期",
      "hint": "删掉"
    },
    {
      "id": "cl-yuan",
      "cat": "closer",
      "w": 3,
      "re": "愿(你我|每一个|每一位|大家都能|我们都能)",
      "hint": "删掉祝愿式收尾"
    },
    {
      "id": "cl-gongtong",
      "cat": "closer",
      "w": 3,
      "re": "(共同|一起)(打造|创造|开创|书写|迎接|共创)[^，。！？；“”\\n]{0,14}(未来|明天|篇章|辉煌|环境)",
      "hint": "删掉口号"
    },
    {
      "id": "cl-xieshou",
      "cat": "closer",
      "w": 3,
      "re": "携手(共进|并进|同行|前行|共创)",
      "hint": "删掉口号"
    },
    {
      "id": "cl-xinpianzhang",
      "cat": "closer",
      "w": 3,
      "re": "开启[^，。！？；“”\\n]{0,10}新(篇章|征程|时代|纪元|旅程)|迈向[^，。！？；“”\\n]{0,8}新(高度|台阶|征程)",
